APP_NAME=PharmaAssist
APP_ENV=development
APP_DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pharmaassist
POSTGRES_USER=pharmaassist
POSTGRES_PASSWORD=pharmaassist_dev_password

DATABASE_URL=postgresql+psycopg://pharmaassist:pharmaassist_dev_password@localhost:5432/pharmaassist

JWT_SECRET_KEY=dev-only-change-me-jwt-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
STUDY_CODE=CSCK700-PHARMAASSIST-2026

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=../storage/tmp
ENABLE_BERTSCORE=true

# Spec Design O3–O5 (post-HITL Confirm only — never auto-prescribe)
ENABLE_SPEC_MCS=true
ENABLE_SPEC_RAG=true
ENABLE_SPEC_GROQ=false
ENABLE_SPEC_SHAP=false
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Real datasets (defaults look under DATA_DIR)
DATA_DIR=D:/Projects/PharmaAssist/data
# FDA_NDC_JSON_PATH=
# FDA_SPL_JSON_PATH=
# DRUGBANK_XML_PATH=
# MEDICINE_CATALOG_DB=

# OCR — production: best operational accuracy (Google Vision primary)
# Research/Spec O1: set OCR_PROFILE=spec for TrOCR → Vision → Tesseract (DQ1)
OCR_STRATEGY=sequential
OCR_PROFILE=production
OCR_PRIMARY=google_vision
OCR_FALLBACK_ORDER=tesseract
OCR_SPEC_PRIMARY=trocr
OCR_SPEC_FALLBACK_ORDER=google_vision,tesseract
OCR_MIN_CONFIDENCE=0.60
OCR_HYBRID_CONSENSUS_ENABLED=false
OCR_PRESERVE_ENGINE_OUTPUTS=false
OCR_ALLOW_MOCK_FALLBACK=true
# Prefer service-account JSON (REST; avoids Windows gRPC blocks):
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/gcp-service-account.json
# Or API key:
# GOOGLE_VISION_API_KEY=
ENABLE_PADDLE_DETECT=true
ENABLE_TROCR_RETRY=true
TROCR_CONFIDENCE_THRESHOLD=0.75
# Handwritten Rx preprocess (best practice — keep ON)
OCR_PREPROCESS_DESKEW=true
OCR_PREPROCESS_INK_ISOLATE=true
OCR_PREPROCESS_BINARIZE=true
OCR_PREPROCESS_SHARPEN=true
OCR_PREPROCESS_MAX_SIDE=2400

